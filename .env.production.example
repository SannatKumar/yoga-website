# Production environment template — copy to `.env` ON THE SERVER and fill in the CHANGE_ME values.
# This file is committed (no secrets). The real `.env` is gitignored and must never be committed.
# See docs/DEPLOYMENT_PLAN.md, step 5.3.

APP_NAME="Yoga App"
APP_ENV=production
# Generated on the server with `php artisan key:generate` — leave empty here.
APP_KEY=
# Never true on a server: debug pages leak file paths, config and DB credentials.
APP_DEBUG=false
# http://YOUR_DROPLET_IP while testing privately; https://yourdomain.com once a domain + HTTPS exist.
APP_URL=http://CHANGE_ME_DROPLET_IP

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yoga_production
DB_USERNAME=yoga_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true only after HTTPS works (step 9), otherwise sessions break over plain http.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# No queue worker runs on the server and the app dispatches no jobs — run anything queued inline.
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
